{
  "appId": "com.fagenesis.genesis",
  "appName": "GENESIS",
  "webDir": "www",
  "server": {
    "url": "https://fagenesis.com/app.html",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "*.stripe.com",
      "*.stripe.network",
      "fagenesis.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#000000"
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false
  }
}
